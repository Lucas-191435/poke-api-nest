enum BattleStatus {
  WAITING_OPPONENT
  SELECTING_LEAD
  IN_PROGRESS
  FINISHED
}

enum BattleTurnState {
  WAITING_ACTION
  ACTION_SUBMITTED
  WAITING_FORCED_SWITCH
}

enum BattleActionType {
  MOVE
  SWITCH
  ITEM
  FORFEIT
}

enum StatusCondition {
  NONE
  PARALYZED
  POISONED
  BURNED
  ASLEEP
  FROZEN
  CONFUSED
}

model Battle {
  id           String              @id @default(uuid())
  status       BattleStatus        @default(WAITING_OPPONENT)
  playerAId    String
  playerBId    String?
  turnNumber   Int                 @default(0)
  winnerId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  playerA      User                @relation("BattlePlayerA", fields: [playerAId], references: [id])
  playerB      User?               @relation("BattlePlayerB", fields: [playerBId], references: [id])
  participants BattleParticipant[]
  turnLogs     BattleTurnLog[]
  user         User?               @relation(fields: [userId], references: [id])
  userId       String?

  @@map("battles")
}

model BattleParticipant {
  id            String          @id @default(uuid())
  battleId      String
  userId        String
  teamName      String // 'teamAlpha' | 'teamBeta' | 'teamGamma' — origem do snapshot
  activeSlot    Int             @default(0)
  turnState     BattleTurnState @default(WAITING_ACTION)
  pendingAction Json?
  forfeited     Boolean         @default(false)
  isBot         Boolean         @default(false) // controlado pelo BattleAiService, setado só via POST /battle/:id/join-bot
  battle        Battle          @relation(fields: [battleId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  pokemons      BattlePokemon[]

  @@unique([battleId, userId])
  @@map("battle_participants")
}

model BattlePokemon {
  id                  String              @id @default(uuid())
  battleParticipantId String
  myPokemonId         String
  position            Int
  maxHp               Int
  currentHp           Int
  atk                 Int
  def                 Int
  spAtk               Int
  spDef               Int
  speed               Int
  statStages          Json                @default("{}") // { atk, def, spAtk, spDef, speed, accuracy, evasion } de -6 a 6
  statusCondition     StatusCondition     @default(NONE)
  statusCounter       Int                 @default(0)
  fainted             Boolean             @default(false)
  participant         BattleParticipant   @relation(fields: [battleParticipantId], references: [id])
  myPokemon           MyPokemon           @relation(fields: [myPokemonId], references: [id])
  moves               BattlePokemonMove[]

  @@map("battle_pokemons")
}

model BattlePokemonMove {
  id              String        @id @default(uuid())
  battlePokemonId String
  moveId          String
  maxPp           Int
  currentPp       Int
  battlePokemon   BattlePokemon @relation(fields: [battlePokemonId], references: [id])
  move            Move          @relation(fields: [moveId], references: [id])

  @@map("battle_pokemon_moves")
}

model BattleTurnLog {
  id                 String           @id @default(uuid())
  battleId           String
  turnNumber         Int
  actorParticipantId String?
  actionType         BattleActionType
  payload            Json // moveId, dano, efetividade, crítico, pokémon trocado, etc.
  createdAt          DateTime         @default(now())
  battle             Battle           @relation(fields: [battleId], references: [id])

  @@map("battle_turn_logs")
}
